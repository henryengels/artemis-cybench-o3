# Copie para .env e preencha.  O .env está no .gitignore e NUNCA deve ser comitado.

# Chave da OpenAI (modelo o3 usado pelo supervisor e pelos subagentes)
OPENAI_API_KEY=sk-...

# Caminhos dos checkouts locais (veja a seção "Como rodar" no README)
CYBENCH_ROOT=/caminho/para/cybench
ARTEMIS_ROOT=/caminho/para/ARTEMIS

# Opcionais
# SUBAGENT_MODEL=o3
# SUPERVISOR_MODEL=o3
# DURATION_PER_TASK=30     # minutos por tarefa
